# Fill these in from YOUR OWN Supabase project (Project Settings -> API).
# Browser-safe values (baked in at build time):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side values (read at runtime by the server):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SECRET: never commit or expose. Needed for admin password resets.
SUPABASE_SERVICE_ROLE_KEY=
